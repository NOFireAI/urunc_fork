#!/busybox sh
# Vz/virtiofs early init. The OCI rootfs remains an unpacked host directory,
# exported read-only as the "rootfs" virtiofs tag. A tmpfs-backed overlay gives
# the guest a writable root without changing the shared image.
BB=/busybox
$BB mount -t proc proc /proc 2>/dev/null
$BB mount -t sysfs sys /sys 2>/dev/null
$BB mount -t devtmpfs dev /dev 2>/dev/null

# HVI currently has no emulated wall-clock RTC. Hull stamps the private initrd
# with the host epoch for HVI boots; setting it once here makes TLS certificate
# validation and build tools work while the kernel clock advances normally.
if [ -s /urunc-epoch ]; then
  _epoch=$($BB cat /urunc-epoch)
  case "$_epoch" in
    ''|*[!0-9]*) ;;
    *) $BB date -u -s "@$_epoch" >/dev/null 2>&1 ;;
  esac
fi

# Rosetta is a host-provided virtiofs share. Register its translator while the
# initramfs path is still reachable; the F flag pins the interpreter across the
# later switch_root. Native ARM64 containers simply omit /urunc-rosetta.
if [ -f /urunc-rosetta ]; then
  $BB mkdir -p /mnt/rosetta /proc/sys/fs/binfmt_misc
  $BB mount -t virtiofs rosetta /mnt/rosetta
  $BB mount -t binfmt_misc none /proc/sys/fs/binfmt_misc
  $BB printf '%s' ':rosetta:M::\x7fELF\x02\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x3e\x00:\xff\xff\xff\xff\xff\xfe\xfe\x00\xff\xff\xff\xff\xff\xff\xff\xff\xfe\xff\xff\xff:/mnt/rosetta/rosetta:OCF' > /proc/sys/fs/binfmt_misc/register
fi

$BB mkdir -p /lowerroot /newroot /run/urunc-overlay
if ! $BB mount -t virtiofs rootfs /lowerroot; then
  echo "vz-init: could not mount virtiofs tag rootfs" >&2
  exec $BB sh
fi

# macOS virtiofs cannot perform every mutation expected by Linux package
# managers (notably temporary mode-000 files). Keep it as the immutable lower
# layer and put all guest writes in initramfs-backed tmpfs.
$BB mount -t tmpfs tmpfs /run/urunc-overlay
$BB mkdir -p /run/urunc-overlay/upper /run/urunc-overlay/work
if ! $BB mount -t overlay overlay \
  -o lowerdir=/lowerroot,upperdir=/run/urunc-overlay/upper,workdir=/run/urunc-overlay/work \
  /newroot; then
  echo "vz-init: overlay unavailable; using virtiofs root directly" >&2
  $BB umount /lowerroot 2>/dev/null
  if ! $BB mount -t virtiofs rootfs /newroot; then
    exec $BB sh
  fi
fi

# Reconstruct the OCI argv and environment from the private initrd copy.
if [ -f /urunc-cmd ]; then
  set --
  while IFS= read -r _a; do set -- "$@" "$_a"; done < /urunc-cmd
fi
if [ -f /urunc-env ]; then
  while IFS= read -r _e; do
    case "$_e" in ''|'#'*) continue ;; *=*) export "$_e" ;; esac
  done < /urunc-env
fi

# Recreate the standard mounts after switch_root. DHCP exposes resolver data in
# /proc/net/pnp; copy it through the writable upper layer before changing root.
$BB mkdir -p /newroot/proc /newroot/sys /newroot/dev /newroot/tmp /newroot/etc
$BB mount -t proc proc /newroot/proc 2>/dev/null
$BB mount -t sysfs sys /newroot/sys 2>/dev/null
$BB mount -t devtmpfs dev /newroot/dev 2>/dev/null
$BB mkdir -p /newroot/dev/pts /newroot/dev/shm
$BB mount -t devpts -o gid=5,mode=0620,ptmxmode=0666 devpts /newroot/dev/pts 2>/dev/null
$BB mount -t tmpfs -o mode=1777 shm /newroot/dev/shm 2>/dev/null
if [ -s /urunc-resolv.conf ]; then
  $BB cp /urunc-resolv.conf /newroot/etc/resolv.conf 2>/dev/null
elif [ -s /proc/net/pnp ]; then
  $BB cp /proc/net/pnp /newroot/etc/resolv.conf 2>/dev/null
fi
[ -s /urunc-hosts ] && $BB cp /urunc-hosts /newroot/etc/hosts 2>/dev/null
[ -s /urunc-hostname ] && $BB cp /urunc-hostname /newroot/etc/hostname 2>/dev/null

# Additional virtiofs shares are encoded as:
# tag<TAB>absolute-guest-path<TAB>ro|rw. They are mounted before the handoff so
# the OCI process sees the requested filesystem with its requested mode.
if [ -f /urunc-mounts ]; then
  while IFS="	" read -r _tag _dest _mode; do
    [ -n "$_tag" ] && [ -n "$_dest" ] || continue
    $BB mkdir -p "/newroot$_dest"
    if [ "$_mode" = ro ]; then
      $BB mount -t virtiofs -o ro "$_tag" "/newroot$_dest" 2>/dev/null
    else
      $BB mount -t virtiofs "$_tag" "/newroot$_dest" 2>/dev/null
    fi
  done < /urunc-mounts
fi

# Install the initrd's static agent in the writable overlay, then start it with
# the container root already in effect. Exec sessions consequently see the OCI
# filesystem, while the shared read-only lower directory stays unchanged.
if [ -x /urunit-agent ]; then
  $BB mkdir -p /newroot/run/urunc
  $BB cp /urunit-agent /newroot/run/urunc/urunit-agent
  $BB cp /busybox /newroot/run/urunc/busybox
  $BB chmod 0755 /newroot/run/urunc/urunit-agent
  $BB chmod 0755 /newroot/run/urunc/busybox
  # Launch from a shell already inside the new root. Running `busybox chroot &`
  # directly races switch_root, which can remove /busybox before the child has
  # exec'd it.
  $BB chroot /newroot /run/urunc/busybox sh -c \
    'URUNIT_AGENT_TRANSPORT=vsock /run/urunc/urunit-agent >/dev/hvc0 2>&1 &'
  $BB rm -f /newroot/run/urunc/busybox
fi

cmd="$1"
case "$cmd" in
  /*) : ;;
  *) for d in /usr/local/sbin /usr/local/bin /usr/sbin /usr/bin /sbin /bin; do
       if [ -x "/newroot$d/$cmd" ]; then cmd="$d/$cmd"; break; fi
     done ;;
esac
shift 2>/dev/null || true
exec $BB switch_root /newroot "$cmd" "$@"
